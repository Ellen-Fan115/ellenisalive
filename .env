NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --scrollbar-width: 3px; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { --bold-color: rgb(227,129,215); --italic-color: rgb(178,229,140); --bg_dark: rgb(243,232,240); --accent-h: 312.76595744680856; --accent-s: 56.6265060240964%; --accent-l: 83.72549019607844%; --bg: rgb(243,232,240); --text-normal: #7B1F1F; --text-muted: #8A3737; --bg_highlight: rgb(228,147,204); --text-faint: #9F5454; --text-accent: #A47676; --text-on-accent: #815858; --text-on-accent-inverted: #BA7171; --text-error: #8E4B4B; --text-warning: #924D4D; --text-success: #A05959; --interactive-hover: #E5F6E7; --interactive-accent: #E5F6E7; --interactive-accent-hover: #D9F0D0; --interactive-accent-hsl: #E5F6E7; --tab-text-color-focused-active: rgb(216,67,146); --link-color: rgb(134,215,235); --scrollbar-bg: rgb(239,155,231); --scrollbar-thumb-bg: rgb(216,151,216); --scrollbar-active-thumb-bg: rgb(248,189,242); --bg_highlight_dark: rgb(67,118,153); --bg_dark2: rgb(144,205,208); --interactive-normal: #E5F6E7; --tab-text-color-focused-active-current: rgb(187,26,46); --tag-color: #D3D57A00; --red: rgb(191,13,13); }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-macos is-frameless is-hidden-frameless obsidian-app show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager h1-divider-on h2-divider-on h3-divider-on callout-style-customize is-fullscreen is-focused
USE_FULL_RESOLUTION_IMAGES=true
dgPassFrontmatter=false